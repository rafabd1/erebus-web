{
  "manifest_version": 2,
  "name": "Erebus Browser Control",
  "version": "1.0.1",
  "description": "Control selected Firefox tabs and capture their traffic in Erebus.",
  "permissions": [
    "activeTab",
    "alarms",
    "proxy",
    "storage",
    "tabs",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["firefox-background.js"]
  },
  "browser_action": {
    "default_title": "Erebus Browser Control",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["firefox-content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "browser-control@erebus.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
