{
  "manifest_version": 3,
  "name": "Erebus Web Capture",
  "version": "0.1.0",
  "description": "Capture selected browser tabs into an Erebus web research session.",
  "permissions": ["activeTab", "alarms", "debugger", "storage", "tabs"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Erebus Web Capture"
  }
}

